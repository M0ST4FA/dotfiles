lazy-lock.json
stow/**/.gitignore
stow/DankMaterialShell/.config/DankMaterialShell/plugins
stow/wireshark/.config/wireshark/recent*
stow/wireshark/.config/wireshark/profiles/*/recent*
.luarc.json
setup.sh

# Private and generated data must never enter Stow packages.
stow/neomutt/.config/neomutt/credentials.rc
stow/mpd/.config/mpd/database
stow/mpd/.config/mpd/state
stow/mpd/.config/mpd/sticker.sql
stow/yazi/.config/yazi/plugins/
stow/yazi/.config/yazi/flavors/
stow/**/.local/share/applications/mimeinfo.cache
stow/mame/.mame/nvram/
stow/mame/.mame/snap/
stow/mame/.mame/sta/

# Noctalia v5 keeps mutable state and downloaded plugins beside its settings.
stow/noctalia/.local/state/noctalia/*
!stow/noctalia/.local/state/noctalia/settings.toml

# nwg-look can export generated GTK4 theme links into the stow package.
stow/nwg-look/.config/gtk-4.0/assets
stow/nwg-look/.config/gtk-4.0/gtk.css
stow/nwg-look/.config/gtk-4.0/gtk-dark.css
