#!/bin/sh

if [ "$#" -ne 3 ]; then
  printf 'usage: %s EMAIL_ADDRESS HOSTNAME TYPE\n' "${0##*/}" >&2
  exit 2
fi

username="$1"
hostname="$2"
protocol="$3"

case "$protocol" in
	imap|imaps|pop|pops|smtp|smtps|nntp|nntps)
		;;
	*)
		printf '%s: unsupported account type: %s\n' "${0##*/}" "$protocol" >&2
		exit 2
		;;
esac

exec secret-tool store \
  --label="NeoMutt $protocol password for $username at $hostname" \
  application neomutt \
  account "$username" \
  hostname "$hostname" \
  protocol "$protocol"
