#!/bin/sh

username=
hostname=
protocol=

check_argument_value() {
	if [ "$#" -lt 2 ]; then
		printf 'neomutt-credentials: %s requires a value\n' "$1" >&2
		exit 2
	fi
}

if [ "$#" -eq 0 ]; then
  printf '%s\n' "neomutt-credentials: no argument provided. expected: username, hostname, type" >&2
  exit 1
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    --username)
	  check_argument_value "$@"
      username="$2"
      shift 2
      ;;
    --hostname)
	  check_argument_value "$@"
	  hostname="$2"
      shift 2
      ;;
	--type)
	  check_argument_value "$@"
	  protocol="$2"
	  shift 2
	  ;;
    *)
	  printf "neomutt-credentials: unknown option: %s\n" "$1" >&2
	  exit 1
      ;;
  esac
done

if [ -z "$username" ]; then
  printf '%s\n' "neomutt-credentials: no account username was supplied" >&2
  exit 1
fi

if [ -z "$hostname" ]; then
  printf '%s\n' "neomutt-credentials: no hostname was supplied" >&2
  exit 1
fi

if [ -z "$protocol" ]; then
  printf '%s\n' "neomutt-credentials: no account type was supplied" >&2
  exit 1
fi

password=$(secret-tool lookup application neomutt account "$username" hostname "$hostname" protocol "$protocol")

if [ -z "$password" ]; then
  printf '%s\n' "neomutt-credentials: no password stored for $username" >&2
  exit 1
fi

printf 'username: %s\n' "$username"
printf 'password: %s\n' "$password"
