#!/bin/sh

username=

while [ "$#" -gt 0 ]; do
  case "$1" in
    --username)
      username=$2
      shift 2
      ;;
    --hostname|--type)
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [ -z "$username" ]; then
  printf '%s\n' "neomutt-credentials: no account username was supplied" >&2
  exit 1
fi

password=$(secret-tool lookup application neomutt account "$username")

if [ -z "$password" ]; then
  printf '%s\n' "neomutt-credentials: no password stored for $username" >&2
  exit 1
fi

printf 'username: %s\n' "$username"
printf 'password: %s\n' "$password"
