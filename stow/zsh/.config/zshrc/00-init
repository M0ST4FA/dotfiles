# -----------------------------------------------------
# Exports
# -----------------------------------------------------
# typeset -U path PATH

export EDITOR=nvim
export SYSTEMD_EDITOR=nvim
export ZSH="$HOME/.oh-my-zsh"
PATH="/home/m0st4fa/.local/bin:/home/m0st4fa/go/bin:$PATH"

# This variable tells zsh about what to consider part of a word.
# I remove some characters so that zsh considers them word boundaries.
export WORDCHARS="${WORDCHARS//\[/_-.]/}"

# -----------------------------------------------------
# Enable zinit
# -----------------------------------------------------
export ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit"
source "$ZINIT_HOME/zinit.zsh"

# -----------------------------------------------------
# Android SDK exports 
# -----------------------------------------------------

# Export Android Home
export ANDROID_HOME="$HOME/Android/Sdk"

# Add tools to PATH
PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"

# Haskell
[ -f "/home/m0st4fa/.ghcup/env" ] && source "/home/m0st4fa/.ghcup/env" # ghcup-env

# Vagrant
export VAGRANT_DEFAULT_PROVIDER=libvirt
export VAGRANT_HOME="$HOME/workspace/infra/vagrant"
